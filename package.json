{
  "name": "disc-market-backend",
  "version": "1.0.0",
  "description": "Backend API para Disc Market (E-commerce de CDs y Vinilos personalizados)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "seed": "ts-node-dev --transpile-only src/seed/seed.ts"
  },
  "keywords": [
